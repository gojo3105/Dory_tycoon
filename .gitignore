# ===== Unity generated =====
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/*
!/[Bb]uilds/.gitkeep
/[Ll]ogs/*
!/[Ll]ogs/.gitkeep
/[Uu]serSettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Never ignore Assets/GameFactory/Build (our C# build automation folder)
!/Assets/GameFactory/Build/

# ===== Generated per-game output =====
# GameFactoryGenerator rebuilds all of this from GameSpecs/*.json at the
# start of every pipeline run, so it is a pure derivative and stays out of
# git - committing generated Unity scenes from both the PC and CI would
# just produce conflicts on files nobody edits by hand.
/Assets/GeneratedGames/
/Assets/GeneratedGames.meta
/Assets/Resources/GameSpecs/
/Assets/Resources/GameSpecs.meta

# Visual Studio / Rider / VS Code cache
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files that should not exist
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated crash reports
sysinfo.txt
crashlytics-build.properties

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Android / Gradle
*.androidlib/
ExportedObj/
.gradle/
gradle-app.setting
local.properties

# Crashlytics generated file
crashlytics-build.properties

# Secrets / signing (never commit)
*.keystore
*.jks
keystore.properties
android-signing.env
.env
Secrets/

# AI_GAME_COMPANY orchestrator runtime artifacts
__pycache__/
*.py[cod]
AI_GAME_COMPANY/company/queue/*.db
AI_GAME_COMPANY/company/state/company_state.json
AI_GAME_COMPANY/logs/
AI_GAME_COMPANY/asset_staging/_incoming/

# Windows runner setup leftovers
scripts/windows-runner/Logs/
# "nul" is a reserved DEVICE name on Windows, not a filename. PowerShell's
# `> nul` creates a real file with that name, and git then cannot open it -
# `git add -A` dies with "unable to index file 'nul'" and stages nothing at
# all, which is how a whole afternoon of Codex output nearly looked lost.
# Never a legitimate file; always an accident.
nul

# Unity/Android 빌드 임시물 (CMake, ninja). 작업물이 아니다.
.utmp/
Reports/control-panel.*.log
